pub fn build_year<const N: usize>(
    years: Option<&Range<Year>>,
    year: Year,
    holidays: [(NaiveDate, &'static str, &'static str); N],
    map: &mut HolidayPerYearMap,
    country: Country,
    country_name: &'static str,
